{
  "name": "ct-backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "rimraf dist && nest build",
    "format": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:fix": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "rimraf dist && nest start",
    "start:dev": "rimraf dist && nest start --watch",
    "start:debug": "rimraf dist && nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "lint:fix:quiet": "eslint --quiet \"src/**/*.ts\" --fix",
    "postinstall": "patch-package",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:ci": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config jest-e2e.json && rimraf test_uploads*",
    "test:e2e:ci": "jest --config jest-e2e.json --coverage && rimraf test_uploads*",
    "seed": "ts-node _ref/seed.ts",
    "typeorm": "typeorm-ts-node-commonjs -d src/orm.datasource.ts",
    "migration:show": "yarn typeorm migration:show",
    "migration:run": "yarn typeorm migration:run",
    "migration:revert": "yarn typeorm migration:revert",
    "migration:create": "node scripts/migration-create.js",
    "migration:generate": "node scripts/migration-generate.js"
  },
  "dependencies": {
    "@jest/globals": "^29.7.0",
    "@mrdrogdrog/optional": "1.2.1",
    "@nestjs/axios": "3.0.1",
    "@nestjs/common": "10.2.10",
    "@nestjs/config": "3.1.1",
    "@nestjs/core": "^10.4.15",
    "@nestjs/event-emitter": "2.0.3",
    "@nestjs/jwt": "10.2.0",
    "@nestjs/passport": "10.0.3",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/schedule": "3.0.4",
    "@nestjs/swagger": "^7.4.2",
    "@nestjs/typeorm": "10.0.1",
    "@nestjs/websockets": "10.2.10",
    "@sendgrid/mail": "^8.1.0",
    "@trivago/prettier-plugin-sort-imports": "^5.2.2",
    "aws-sdk": "^2.1320.0",
    "axios": "^1.5.1",
    "bcrypt": "^5.1.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "cli-color": "^2.0.3",
    "compression": "^1.7.5",
    "connect-typeorm": "^2.0.0",
    "dotenv": "^16.4.7",
    "eventemitter2": "6.4.9",
    "express": "^4.21.2",
    "google-auth-library": "^9.11.0",
    "google-spreadsheet": "^4.1.2",
    "googleapis": "^122.0.0",
    "joi": "^17.0.0",
    "jsonwebtoken": "^9.0.2",
    "lodash": "^4.17.21",
    "openai": "^4.60.0",
    "passport": "^0.6.0",
    "passport-jwt": "^4.0.1",
    "patch-package": "^8.0.0",
    "pg": "^8.4.0",
    "postgres-interval": "^4.0.2",
    "raw-body": "^3.0.0",
    "reflect-metadata": "^0.1.13",
    "rimraf": "^3.0.2",
    "rxjs": "^7.2.0",
    "short-unique-id": "^4.4.4",
    "ts-node": "^10.9.2",
    "typeorm": "0.3.17",
    "unique-names-generator": "^4.7.1"
  },
  "devDependencies": {
    "@darraghor/eslint-plugin-nestjs-typed": "4.5.0",
    "@nestjs/cli": "^10.4.9",
    "@types/bcrypt": "^5.0.2",
    "@types/cli-color": "^2.0.6",
    "@types/compression": "^1.7.5",
    "@types/express": "^4.17.13",
    "@types/lodash": "^4.14.195",
    "@types/multer": "^1.4.12",
    "@types/passport-jwt": "^3.0.8",
    "@typescript-eslint/eslint-plugin": "6.13.2",
    "@typescript-eslint/parser": "6.13.2",
    "eslint": "8.55.0",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-jest": "27.6.3",
    "eslint-plugin-local-rules": "2.0.1",
    "eslint-plugin-prettier": "5.0.1",
    "jest": "29.7.0",
    "mocked-env": "^1.3.5",
    "prettier": "^3.2.5",
    "ts-jest": "^29.1.2",
    "typescript": "5.3.3",
    "yargs": "^17.7.2"
  },
  "engines": {
    "node": "23.x",
    "yarn": ">= 1.19.1 <2.0.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".spec.ts$",
    "transform": {
      "^.+\\.(t|j)s$": [
        "ts-jest",
        {
          "tsconfig": "test/tsconfig.json"
        }
      ]
    },
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "reporters": [
      "default",
      "github-actions"
    ]
  }
}
